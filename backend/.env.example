# ============================================================
# CyberNews Backend - Variabili d'ambiente (PROTETTE)
# ============================================================

# Chiave API Google Gemini 2.0 Flash (da Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Credenziali Supabase (Piano Free)
# URL del tuo progetto Supabase (es. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Service Role Key (USATA SOLO DA QUESTO SCRIPT PER SCRIVERE SUL DB - NON CONDIVIDERE MAI)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Anon Key Pubblica (quella che userà l'App iOS per leggere le notizie)
SUPABASE_ANON_KEY=your_anon_public_key_here
