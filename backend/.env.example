# ============================================================
# CyberNews Backend - Variabili d'ambiente (PROTETTE)
# ============================================================

# Chiave API Google Gemini (da Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Credenziali Supabase (Piano Free)
# URL del tuo progetto Supabase (es. https://stkmmwwpwrbnkigkuwdp.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Service Role Key (USATA SOLO DA GITHUB ACTIONS / SCRIPT PER SCRIVERE SUL DB)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Anon Key Pubblica (per lettura RLS)
SUPABASE_ANON_KEY=your_anon_public_key_here

# ============================================================
# Notifiche Push Remote a Schermo Spento (Zero Costi)
# ============================================================
# Canale 1: Telegram Bot (Consigliato, 100% gratuito, zero certificati Apple)
# 1. Crea un bot su Telegram scrivendo a @BotFather e copia il token
# 2. Ottieni il tuo ID chat scrivendo /start a @userinfobot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Canale 2: OneSignal (Notifiche push native via APNs, richiede account OneSignal)
ONESIGNAL_APP_ID=your_onesignal_app_id_here
ONESIGNAL_REST_API_KEY=your_onesignal_rest_api_key_here
